{
  "mcpServers": {
    "godot": {
      "command": "npx",
      "args": ["-y", "@coding-solo/godot-mcp@0.1.1"],
      "env": {
        "DEBUG": "false"
      }
    },
    "godot-alex": {
      "command": "node",
      "args": [
        "${HOME}/.local/share/godot-mcp-alexmeckes/dist/index.js",
        "--project",
        "${CLAUDE_PROJECT_DIR:-.}"
      ]
    }
  }
}
