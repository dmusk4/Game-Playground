{
  "enabledMcpjsonServers": [
    "godot",
    "godot-alex"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-godot.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "godot-prompter-marketplace": {
      "source": {
        "source": "github",
        "repo": "jame581/GodotPrompter"
      }
    }
  },
  "enabledPlugins": {
    "godot-prompter@godot-prompter-marketplace": true
  }
}
